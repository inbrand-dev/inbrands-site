{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inbrands.app/orion-hub/dashboard/project-snapshot.schema.json",
  "title": "Orion Hub Project Snapshot",
  "description": "Versioned universal snapshot contract. Historical canonical snapshots are immutable once written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "capturedAt",
    "project",
    "milestone",
    "currentWorkUnit",
    "remainingWorkUnits",
    "recentlyCompleted",
    "deferred",
    "openDecisions",
    "blockers",
    "changesSincePrior",
    "evidenceBaseline",
    "hours",
    "tempo",
    "reconciliation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "terminology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "milestone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "workUnit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "definitionOfDone",
        "state",
        "originalForecast"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "definitionOfDone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "originalForecast": {
          "$ref": "#/$defs/datedHourEstimate"
        }
      }
    },
    "currentWorkUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "plainEnglishGoal",
        "state",
        "currentGate",
        "nextAction",
        "blockers",
        "dependencies"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "plainEnglishGoal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "currentGate": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "nextAction": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "remainingWorkUnits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workItem"
      }
    },
    "recentlyCompleted": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/workItem"
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deferredItem"
      }
    },
    "openDecisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "changesSincePrior": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/noteItem"
      }
    },
    "evidenceBaseline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cumulativeProject",
        "spentDuringMilestone",
        "remainingToMilestone",
        "projectedMilestoneTotal",
        "forecastDrift",
        "forecastHistory"
      ],
      "properties": {
        "cumulativeProject": {
          "$ref": "#/$defs/recalculatedHourEstimate"
        },
        "spentDuringMilestone": {
          "$ref": "#/$defs/hourEstimate"
        },
        "remainingToMilestone": {
          "$ref": "#/$defs/hourEstimate"
        },
        "projectedMilestoneTotal": {
          "$ref": "#/$defs/hourEstimate"
        },
        "forecastDrift": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hours",
            "percent",
            "classification"
          ],
          "properties": {
            "hours": {
              "type": [
                "number",
                "null"
              ]
            },
            "percent": {
              "type": [
                "number",
                "null"
              ]
            },
            "classification": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Scope Change",
                  "Execution Variance",
                  "Required Discovery",
                  "Estimate Refinement"
                ]
              }
            }
          }
        },
        "forecastHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capturedAt",
              "projectedTotalBest",
              "remainingBest"
            ],
            "properties": {
              "capturedAt": {
                "type": "string",
                "format": "date-time"
              },
              "projectedTotalBest": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "remainingBest": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "tempo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowLabel",
        "totalHoursApprox",
        "plannedHours",
        "discoveryHours",
        "addedScopeHours",
        "unplannedHours"
      ],
      "properties": {
        "windowLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "totalHoursApprox": {
          "type": "number",
          "minimum": 0
        },
        "plannedHours": {
          "type": "number",
          "minimum": 0
        },
        "discoveryHours": {
          "type": "number",
          "minimum": 0
        },
        "addedScopeHours": {
          "type": "number",
          "minimum": 0
        },
        "unplannedHours": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priorSnapshotId",
        "targets",
        "newScope"
      ],
      "properties": {
        "priorSnapshotId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reconciliationTarget"
          }
        },
        "newScope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/newScopeItem"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "hourEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "best",
        "low",
        "high"
      ],
      "properties": {
        "best": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "low": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "high": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "datedHourEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "best",
        "low",
        "high",
        "establishedAt"
      ],
      "properties": {
        "best": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "low": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "high": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "establishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "recalculatedHourEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "best",
        "low",
        "high",
        "lastRecalculated"
      ],
      "properties": {
        "best": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "low": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "high": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "lastRecalculated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "goal": {
          "type": "string",
          "maxLength": 3000
        },
        "note": {
          "type": "string",
          "maxLength": 3000
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "anyOf": [
        {
          "required": [
            "goal"
          ]
        },
        {
          "required": [
            "note"
          ]
        }
      ]
    },
    "deferredItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "movedTo": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "answerNeeded": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "impact",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "noteItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "reconciliationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "name",
        "disposition",
        "note"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "disposition": {
          "enum": [
            "COMPLETED",
            "CARRIED FORWARD / ACTIVE",
            "DEFERRED",
            "BLOCKED",
            "SUPERSEDED",
            "REMOVED / CANCELED",
            "UNRESOLVED"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "replacementId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "ownerDecisionReference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "SUPERSEDED"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "replacementId"
            ],
            "properties": {
              "replacementId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "REMOVED / CANCELED"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "ownerDecisionReference"
            ],
            "properties": {
              "ownerDecisionReference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "newScopeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    }
  }
}
